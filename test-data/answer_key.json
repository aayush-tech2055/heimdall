{
  "version": 1,
  "about": "Expected flags for every content item. Rules are named by stable keys (see 'rules'), because rule codes are assigned at extraction; the evaluation maps each key to the extracted rule whose text matches best. Fact codes follow the row order of facts.csv (row 1 = F-001). 'evidence' is the exact quote ('' for a missing required phrase). 'alt_sources' are other sources that also count as correct. Before running the evaluation, approve every extracted rule except those listed in 'reject' (the vague rules, the duplicate and one side of the contradiction), and approve all facts.",
  "brands": {
    "acmelearn": {
      "name": "AcmeLearn",
      "rules": {
        "ACM-TONE-WARM": "Use a warm, encouraging tone. Never mock, shame or pressure learners about their skills, age, background or progress.",
        "ACM-TONE-YOU": "Address the reader directly as \"you\" and write in the active voice.",
        "ACM-TONE-EXCITING": "Content should feel exciting and on-brand.",
        "ACM-TONE-EXCL": "Use at most one exclamation mark per piece of content, and never write whole words in capital letters for emphasis.",
        "ACM-TERM-BANNED": "Never use these words: \"cheap\", \"hack\", \"dummies\", \"guaranteed job\".",
        "ACM-TERM-NAME": "Always write our name as AcmeLearn, one word. Never write \"Acme Learn\" or \"Acme-Learn\".",
        "ACM-TERM-PLANS": "Our paid plans are called AcmeLearn Plus and AcmeLearn Pro. Never call them \"premium plan\" or \"gold plan\".",
        "ACM-TERM-LEARNERS": "Call the people who use AcmeLearn \"learners\". Do not call them \"students\".",
        "ACM-MSG-OUTCOMES": "Lead with what learners can do after a course (skills, projects, portfolio pieces), not with a list of platform features.",
        "ACM-MSG-IMPACTFUL": "Messaging should be impactful and inspire trust.",
        "ACM-CLAIM-JOBS": "Never promise jobs, salaries, placements or income. We teach skills; we do not guarantee careers.",
        "ACM-CLAIM-FACTS": "Every number, price, ranking or statistic must match the approved AcmeLearn fact sheet.",
        "ACM-CLAIM-SUPERLATIVE": "Do not use superlatives such as \"best\", \"No. 1\" or \"India's top\" unless an approved fact supports them.",
        "ACM-CLAIM-PRICE": "Always state the monthly price of the plan you are promoting.",
        "ACM-MSG-NOCHEAP": "Do not describe any course or plan as cheap.",
        "ACM-VIS-COLOURS": "Use only the AcmeLearn indigo (#3B2F8F) and saffron (#F4A300) as accent colours, on white or very light grey backgrounds.",
        "ACM-VIS-LOGO": "Place the AcmeLearn logo on a white or indigo background only. Never stretch, rotate or recolour it.",
        "ACM-ACC-ALT": "Every image must have alt text that describes what the image shows.",
        "ACM-ACC-READING": "Write so that a 14-year-old can follow: keep sentences under 25 words and explain any technical term the first time you use it.",
        "ACM-ACC-INCLUSIVE": "Use inclusive, gender-neutral language: write \"everyone\" or \"folks\", not \"guys\".",
        "ACM-LEGAL-NOPRICE-SOCIAL": "Social media captions must not mention prices. Link to acmelearn.example/pricing instead.",
        "ACM-LEGAL-COMPETITORS": "Never mention competitors by name, including Coursify and SkillNest.",
        "ACM-LEGAL-PRIVACY": "Do not use a learner's name, photo or results without their written consent, and never publish anyone's phone number or email address.",
        "ACM-LEGAL-TC": "Every piece of promotional content must end with the line \"T&Cs apply.\"",
        "ACM-LEGAL-AWARD-SOURCE": "Award and rating claims must name the source and the year."
      },
      "reject": [
        "ACM-TONE-EXCITING",
        "ACM-MSG-IMPACTFUL",
        "ACM-MSG-NOCHEAP",
        "ACM-CLAIM-PRICE"
      ],
      "verification": {
        "vague": [
          "ACM-TONE-EXCITING",
          "ACM-MSG-IMPACTFUL"
        ],
        "duplicates": [
          [
            "ACM-TERM-BANNED",
            "ACM-MSG-NOCHEAP"
          ]
        ],
        "contradictions": [
          [
            "ACM-CLAIM-PRICE",
            "ACM-LEGAL-NOPRICE-SOCIAL"
          ]
        ],
        "missing_categories": []
      }
    },
    "brewbird": {
      "name": "Brewbird Coffee",
      "rules": {
        "BB-TONE-FRIENDLY": "Sound friendly and curious, like a barista chatting with a regular. Be playful, but never sarcastic or rude about other people's coffee choices.",
        "BB-TONE-SIMPLE": "Keep it simple: use everyday words, not coffee-industry jargon, unless you explain it.",
        "BB-TONE-ENERGY": "Posts should have good energy and feel premium.",
        "BB-TONE-PLEASURE": "Talk about coffee as an everyday pleasure. Never describe it as an addiction or a drug.",
        "BB-TERM-BANNED": "Never use these words: \"instant\", \"cheap\", \"addictive\", \"jitter juice\".",
        "BB-TERM-NAME": "Write our name as Brewbird, one word. Never write \"Brew Bird\" or \"Brew-bird\".",
        "BB-TERM-FLIGHTCLUB": "Our subscription is called the Brewbird Flight Club. Never call it a \"membership\" or a \"coffee box\".",
        "BB-TERM-PARTNERS": "Call the people who grow our coffee \"estate partners\". Do not call them \"suppliers\".",
        "BB-CLAIM-HEALTH": "Never make health claims. Do not say coffee boosts immunity, burns fat, cures headaches or prevents disease.",
        "BB-CLAIM-FACTS": "Every price, rating, origin, roast date or statistic must match the approved Brewbird fact sheet.",
        "BB-CLAIM-SUPERLATIVE": "Do not say \"best coffee in India\" or \"world's best\" or any similar superlative unless an approved fact supports it.",
        "BB-CLAIM-ESTATE": "Always mention the estate a coffee comes from when you name a coffee.",
        "BB-CLAIM-ORIGIN": "Origin claims must be specific and true; never call a blend \"single-estate\".",
        "BB-CLAIM-GREATTASTE": "Words like \"great taste\" should be used carefully.",
        "BB-VIS-PALETTE": "Use the Brewbird palette only: roast brown (#4A2C2A), crema (#F3E5D0) and leaf green (#2E7D4F).",
        "BB-VIS-PACKAGING": "Product photos must show the real packaging; never show a competitor's cup or bag.",
        "BB-ACC-ALT": "Every image needs alt text that describes the product and the setting.",
        "BB-ACC-CONTRAST": "Never put text over a busy photo; text must have a contrast ratio of at least 4.5:1.",
        "BB-VIS-NODRUG": "Never refer to coffee as a drug or an addiction.",
        "BB-LEGAL-DISCLAIMER": "Every post that promotes a product must end with the line \"Contains caffeine. Not recommended for children or pregnant women.\"",
        "BB-LEGAL-COMPETITORS": "Never mention competitors by name, including Bean Street and Kaapi Kart.",
        "BB-LEGAL-DISCOUNT-END": "Discounts must state the end date of the offer.",
        "BB-LEGAL-ESTATE-CONF": "Do not name our estate partners or their estates in public posts; partner names are confidential.",
        "BB-LEGAL-REVIEWS": "Do not use customer reviews or photos without written permission.",
        "BB-LEGAL-PRIVACY": "Never collect or publish customers' phone numbers or addresses in public posts."
      },
      "reject": [
        "BB-TONE-ENERGY",
        "BB-CLAIM-GREATTASTE",
        "BB-VIS-NODRUG",
        "BB-LEGAL-ESTATE-CONF"
      ],
      "verification": {
        "vague": [
          "BB-TONE-ENERGY",
          "BB-CLAIM-GREATTASTE"
        ],
        "duplicates": [
          [
            "BB-TONE-PLEASURE",
            "BB-VIS-NODRUG"
          ]
        ],
        "contradictions": [
          [
            "BB-CLAIM-ESTATE",
            "BB-LEGAL-ESTATE-CONF"
          ]
        ],
        "missing_categories": []
      }
    }
  },
