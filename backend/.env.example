# Copy to backend/.env and fill in. Never commit real values.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Supabase (Postgres + pgvector, Auth, Storage)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Password for the demo users created by `python -m scripts.seed` (min 8 characters)
SEED_USER_PASSWORD=

# AI providers: tried in this order; providers without a key are skipped
LLM_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Redaction: spaCy model for Presidio names/places (only if Presidio is installed)
PRESIDIO_SPACY_MODEL=en_core_web_sm

# Local SQLite cache for LLM responses
LLM_CACHE_PATH=.cache/llm_cache.sqlite3
